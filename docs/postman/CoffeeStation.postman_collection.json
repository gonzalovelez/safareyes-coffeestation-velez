{
  "info": {
    "name": "CoffeeStation",
    "description": "API REST de la cafetería CoffeeStation. Usa el entorno 'CoffeeStation local' (variable baseUrl).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Productos",
      "item": [
        {
          "name": "1. GET /productos - Carta con filtros",
          "description": "Carta paginada (10 por página, ordenada por nombre). Filtros opcionales y combinables: categoriaId, texto, precioMax, disponible, sinAlergenoId. RN-01: nunca salen productos dados de baja.",
          "item": [
            {
              "name": "Carta completa (página 0)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?page=0&size=10",
                "description": "Primera página de la carta. 'page' trae size, number, totalElements y totalPages."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                      "pm.test('18 productos activos (hay 2 de baja)', () => pm.expect(pm.response.json().page.totalElements).to.eql(18));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Filtro: por categoría (Cafés)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?categoriaId=1",
                "description": "Solo productos de la categoría 1 (Cafés)."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                      "pm.response.json().content.forEach(p => pm.expect(p.categoria === 'Cafés').to.be.true);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Filtro: texto en el nombre",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?texto=café",
                "description": "Productos cuyo nombre contiene 'café' (sin distinguir mayúsculas)."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                      "pm.response.json().content.forEach(p => pm.expect(p.nombre.toLowerCase().includes('café')).to.be.true);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Filtro: precio máximo",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?precioMax=1.50",
                "description": "Productos de 1,50 € o menos."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                      "pm.response.json().content.forEach(p => pm.expect(p.precio <= 1.50).to.be.true);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Filtro: solo agotados",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?disponible=false",
                "description": "Productos activos marcados como agotados (Café bombón y la bollería). La Ensaimada también está agotada pero no sale porque está dada de baja (RN-01)."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                      "pm.response.json().content.forEach(p => pm.expect(p.disponible === false).to.be.true);",
                      "pm.test('No sale la Ensaimada (de baja)', () => pm.expect(pm.response.json().content.map(p => p.nombre)).to.not.include('Ensaimada'));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Filtro: sin un alérgeno (sin lácteos)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?sinAlergenoId=7",
                "description": "Productos que NO contienen el alérgeno 7 (Lácteos)."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                      "pm.response.json().content.forEach(p => pm.expect(!p.alergenos.includes('Lácteos')).to.be.true);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Filtros combinados",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?categoriaId=4&sinAlergenoId=3&precioMax=4&disponible=true",
                "description": "Bocadillos sin huevo, de 4 € o menos y disponibles. Se pueden combinar todos los filtros."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                      "pm.response.json().content.forEach(p => pm.expect(p.categoria === 'Bocadillos' && !p.alergenos.includes('Huevo') && p.precio <= 4 && p.disponible).to.be.true);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Ordenar por precio descendente",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?sort=precio,desc&size=5",
                "description": "Los 5 productos más caros de la carta."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                      "const precios = pm.response.json().content.map(p => p.precio);",
                      "pm.test('Ordenado de mayor a menor', () => pm.expect(precios).to.eql([...precios].sort((a, b) => b - a)));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "RN-01: producto de baja no sale en la carta",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?texto=ensaimada",
                "description": "La Ensaimada (id 12) está dada de baja: no aparece en la carta aunque se busque por su nombre."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                      "pm.test('Ningún resultado', () => pm.expect(pm.response.json().page.totalElements).to.eql(0));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Error: precio no numérico (400)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?precioMax=caro",
                "description": "Un filtro con un tipo incorrecto devuelve 400 con ProblemDetail."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 400', () => pm.response.to.have.status(400));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Error: ordenar por un campo que no existe (400)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?sort=noexiste",
                "description": "Ordenar por un campo inexistente devuelve 400."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 400', () => pm.response.to.have.status(400));"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "2. GET /productos/{id} - Detalle",
          "description": "Detalle de un producto activo con sus alérgenos.",
          "item": [
            {
              "name": "Detalle con alérgenos (Croissant)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos/9",
                "description": "El Croissant tiene gluten, huevo y lácteos."
