{
  "info": {
    "name": "CoffeeStation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Productos",
      "item": [
        {
          "name": "1. GET /productos",
          "item": [
            {
              "name": "Carta",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?page=0&size=10"
              }
            },
            {
              "name": "Por categoría",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?categoriaId=1"
              }
            },
            {
              "name": "Por texto",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?texto=café"
              }
            },
            {
              "name": "Precio máximo",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?precioMax=1.50"
              }
            },
            {
              "name": "Solo agotados",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?disponible=false"
              }
            },
            {
              "name": "Sin alérgeno (lácteos)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?sinAlergenoId=7"
              }
            },
            {
              "name": "Filtros combinados",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?categoriaId=4&sinAlergenoId=3&precioMax=4&disponible=true"
              }
            },
            {
              "name": "RN-01: producto de baja no sale",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?texto=ensaimada"
              }
            }
          ]
        },
        {
          "name": "2. GET /productos/{id}",
          "item": [
            {
              "name": "Detalle con alérgenos",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos/9"
              }
            },
            {
              "name": "404 no existe",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos/9999"
              }
            },
            {
              "name": "RN-01: producto de baja (404)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos/12"
              }
            }
          ]
        },
        {
          "name": "3. POST /productos",
          "item": [
            {
              "name": "Crear producto",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/productos",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"nombre\": \"Muffin de arándanos\", \"descripcion\": \"Muffin casero con arándanos\", \"precio\": 2.1, \"categoriaId\": 3, \"alergenosIds\": [1, 3, 7]}"
                }
              }
            },
            {
              "name": "400 sin nombre ni precio",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/productos",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"descripcion\": \"Sin nombre\", \"categoriaId\": 1}"
                }
              }
            },
            {
              "name": "404 categoría no existe",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/productos",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"nombre\": \"Prueba\", \"precio\": 1.0, \"categoriaId\": 99}"
                }
              }
            },
            {
              "name": "404 alérgeno no existe",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/productos",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"nombre\": \"Prueba\", \"precio\": 1.0, \"categoriaId\": 1, \"alergenosIds\": [1, 99]}"
                }
              }
            }
          ]
        },
        {
          "name": "4. PUT /productos/{id}",
          "item": [
            {
              "name": "Modificar producto",
              "request": {
                "method": "PUT",
                "url": "{{baseUrl}}/productos/21",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"nombre\": \"Muffin de arándanos\", \"descripcion\": \"Muffin casero, ahora más grande\", \"precio\": 2.4, \"categoriaId\": 3, \"alergenosIds\": [1, 7]}"
                }
              }
            },
            {
              "name": "404 no existe",
              "request": {
                "method": "PUT",
                "url": "{{baseUrl}}/productos/9999",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"nombre\": \"Prueba\", \"precio\": 1.0, \"categoriaId\": 1}"
                }
              }
            },
            {
              "name": "RN-01: producto de baja (422)",
              "request": {
                "method": "PUT",
                "url": "{{baseUrl}}/productos/12",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"nombre\": \"Ensaimada\", \"precio\": 1.9, \"categoriaId\": 3}"
                }
              }
            }
          ]
        },
        {
          "name": "5. PATCH /productos/{id}/disponibilidad",
          "item": [
            {
              "name": "Marcar agotado",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/productos/21/disponibilidad",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"disponible\": false}"
                }
              }
            },
            {
              "name": "Reponer",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/productos/21/disponibilidad",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"disponible\": true}"
                }
              }
            },
            {
              "name": "404 no existe",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/productos/9999/disponibilidad",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"disponible\": false}"
                }
              }
            },
            {
              "name": "RN-01: producto de baja (422)",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/productos/12/disponibilidad",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"disponible\": true}"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
