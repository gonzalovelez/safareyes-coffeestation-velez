                "description": "La Ensaimada está dada de baja: ya no forma parte de la carta y se responde 404."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 404', () => pm.response.to.have.status(404));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Error: id no numérico (400)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos/abc",
                "description": "Un id que no es un número devuelve 400."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 400', () => pm.response.to.have.status(400));"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "3. POST /productos - Alta (ADMIN)",
          "description": "Alta de producto. Nace activo y disponible. Responde 201 con la cabecera Location. Ejecuta primero 'Crear producto': guarda su id en la variable productoCreadoId, que usan los endpoints 4 y 5 para no modificar los datos de prueba.",
          "item": [
            {
              "name": "Crear producto",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/productos",
                "description": "Crea un producto con categoría y alérgenos. 201 + Location: /api/v1/productos/{id}.",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Muffin de arándanos\",\n  \"descripcion\": \"Muffin casero con arándanos\",\n  \"precio\": 2.1,\n  \"categoriaId\": 3,\n  \"alergenosIds\": [\n    1,\n    3,\n    7\n  ]\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 201', () => pm.response.to.have.status(201));",
                      "pm.test('Cabecera Location', () => pm.response.to.have.header('Location'));",
                      "const p = pm.response.json();",
                      "pm.test('Nace disponible', () => pm.expect(p.disponible).to.be.true);",
                      "pm.collectionVariables.set('productoCreadoId', p.id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Error: sin nombre ni precio (400)",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/productos",
                "description": "Faltan campos obligatorios: la respuesta indica cada campo en 'errores'.",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"descripcion\": \"Sin nombre\",\n  \"categoriaId\": 1\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 400', () => pm.response.to.have.status(400));",
                      "pm.test('Indica los campos', () => pm.expect(pm.response.json().errores).to.have.keys('nombre', 'precio'));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Error: precio negativo (400)",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/productos",
                "description": "El precio tiene que ser mayor que 0.",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Café gratis\",\n  \"precio\": -1.0,\n  \"categoriaId\": 1\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 400', () => pm.response.to.have.status(400));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Error: precio con 3 decimales (400)",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/productos",
                "description": "El dinero admite como mucho 2 decimales.",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Café raro\",\n  \"precio\": 1.555,\n  \"categoriaId\": 1\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 400', () => pm.response.to.have.status(400));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Error: categoría inexistente (404)",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/productos",
                "description": "La categoría 99 no existe.",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Producto huérfano\",\n  \"precio\": 1.0,\n  \"categoriaId\": 99\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 404', () => pm.response.to.have.status(404));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Error: alérgeno inexistente (404)",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/productos",
                "description": "El alérgeno 99 no existe: el mensaje indica qué ids fallan.",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Producto raro\",\n  \"precio\": 1.0,\n  \"categoriaId\": 1,\n  \"alergenosIds\": [\n    1,\n    99\n  ]\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
