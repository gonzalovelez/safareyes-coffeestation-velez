{
  "info": {
    "name": "CoffeeStation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Productos",
      "item": [
        {
          "name": "1. GET /productos",
          "item": [
            {
              "name": "[PRINCIPAL] Carta",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?page=0&size=10"
              }
            },
            {
              "name": "[RF-02] Por categoría",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?categoriaId=1"
              }
            },
            {
              "name": "[RF-02] Por texto",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?texto=café"
              }
            },
            {
              "name": "[RF-02] Precio máximo",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?precioMax=1.50"
              }
            },
            {
              "name": "[RF-02] Solo agotados",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?disponible=false"
              }
            },
            {
              "name": "[RF-02] Sin alérgeno (lácteos)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?sinAlergenoId=7"
              }
            },
            {
              "name": "[RF-02] Filtros combinados",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?categoriaId=4&sinAlergenoId=3&precioMax=4&disponible=true"
              }
            },
            {
              "name": "[RN-01] Producto de baja no sale",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos?texto=ensaimada"
              }
            }
          ]
        },
        {
          "name": "2. GET /productos/{id}",
          "item": [
            {
              "name": "[PRINCIPAL] Detalle con alérgenos",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos/9"
              }
            },
            {
              "name": "[ERROR 404] No existe",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos/9999"
              }
            },
            {
              "name": "[RN-01] Producto de baja da 404",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/productos/12"
              }
            }
          ]
        },
        {
          "name": "3. POST /productos",
          "item": [
            {
              "name": "[PRINCIPAL] Crear producto (201 + Location)",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/productos",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"nombre\": \"Muffin de arándanos\", \"descripcion\": \"Muffin casero con arándanos\", \"precio\": 2.1, \"categoriaId\": 3, \"alergenosIds\": [1, 3, 7]}"
                }
              }
            },
            {
              "name": "[ERROR 400] Sin nombre ni precio",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/productos",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"descripcion\": \"Sin nombre\", \"categoriaId\": 1}"
                }
              }
            },
            {
              "name": "[ERROR 404] Categoría no existe",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/productos",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"nombre\": \"Prueba\", \"precio\": 1.0, \"categoriaId\": 99}"
                }
              }
            },
            {
              "name": "[ERROR 404] Alérgeno no existe",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/productos",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"nombre\": \"Prueba\", \"precio\": 1.0, \"categoriaId\": 1, \"alergenosIds\": [1, 99]}"
                }
              }
            }
          ]
        },
        {
          "name": "4. PUT /productos/{id}",
          "item": [
            {
              "name": "[PRINCIPAL] Modificar producto",
              "request": {
                "method": "PUT",
                "url": "{{baseUrl}}/productos/21",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"nombre\": \"Muffin de arándanos\", \"descripcion\": \"Muffin casero, ahora más grande\", \"precio\": 2.4, \"categoriaId\": 3, \"alergenosIds\": [1, 7]}"
                }
              }
            },
            {
              "name": "[ERROR 404] No existe",
              "request": {
                "method": "PUT",
                "url": "{{baseUrl}}/productos/9999",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"nombre\": \"Prueba\", \"precio\": 1.0, \"categoriaId\": 1}"
                }
              }
            },
            {
              "name": "[EXTRA] Producto de baja da 422",
              "request": {
                "method": "PUT",
                "url": "{{baseUrl}}/productos/12",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"nombre\": \"Ensaimada\", \"precio\": 1.9, \"categoriaId\": 3}"
                }
              }
            }
          ]
        },
        {
          "name": "5. PATCH /productos/{id}/disponibilidad",
          "item": [
            {
              "name": "[PRINCIPAL] Marcar agotado",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/productos/21/disponibilidad",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"disponible\": false}"
                }
              }
            },
            {
              "name": "[PRINCIPAL] Reponer",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/productos/21/disponibilidad",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"disponible\": true}"
                }
              }
            },
            {
              "name": "[ERROR 404] No existe",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/productos/9999/disponibilidad",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"disponible\": false}"
                }
              }
            },
            {
              "name": "[EXTRA] Producto de baja da 422",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/productos/12/disponibilidad",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"disponible\": true}"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
