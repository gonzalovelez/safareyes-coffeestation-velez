{
  "info": {
    "name": "CoffeeStation",
    "description": "API REST de la cafetería CoffeeStation. Usa el entorno 'CoffeeStation local' (variable baseUrl).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Productos",
      "item": [
        { "name": "Listar carta (paginado)", "request": { "method": "GET", "url": "{{baseUrl}}/productos?page=0&size=10" } },
        { "name": "Buscar producto por id", "request": { "method": "GET", "url": "{{baseUrl}}/productos/1" } },
        { "name": "Error: producto inexistente (404)", "request": { "method": "GET", "url": "{{baseUrl}}/productos/9999" } },
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/productos",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Café con leche\",\n  \"descripcion\": \"Café espresso con leche caliente\",\n  \"precio\": 1.60,\n  \"categoriaId\": 1,\n  \"alergenosIds\": [1]\n}" }
          }
        },
        {
          "name": "Error: crear producto sin nombre (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/productos",
            "body": { "mode": "raw", "raw": "{\n  \"precio\": 1.60,\n  \"categoriaId\": 1\n}" }
          }
        },
        {
          "name": "Modificar producto",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/productos/1",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Café con leche\",\n  \"descripcion\": \"Ahora más grande\",\n  \"precio\": 1.80,\n  \"categoriaId\": 1,\n  \"alergenosIds\": [1]\n}" }
          }
        },
        {
          "name": "Cambiar disponibilidad",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/productos/1/disponibilidad",
            "body": { "mode": "raw", "raw": "{\n  \"disponible\": false\n}" }
          }
        },
        { "name": "Dar de baja producto", "request": { "method": "DELETE", "url": "{{baseUrl}}/productos/1" } }
      ]
    },
    {
      "name": "Categorías",
      "item": [
        { "name": "Listar categorías", "request": { "method": "GET", "url": "{{baseUrl}}/categorias" } },
        {
          "name": "Cambiar disponibilidad",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/categorias/1/disponibilidad",
            "body": { "mode": "raw", "raw": "{\n  \"disponible\": false\n}" }
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Crear pedido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/pedidos",
            "body": { "mode": "raw", "raw": "{\n  \"clienteId\": 1,\n  \"lineas\": [\n    { \"productoId\": 1, \"cantidad\": 2 },\n    { \"productoId\": 3, \"cantidad\": 1 }\n  ],\n  \"codigoCupon\": null,\n  \"dniSocio\": null\n}" }
          }
        },
        {
          "name": "Error: pedido sin líneas (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/pedidos",
            "body": { "mode": "raw", "raw": "{\n  \"lineas\": []\n}" }
          }
        },
        { "name": "Buscar pedido por id", "request": { "method": "GET", "url": "{{baseUrl}}/pedidos/1" } },
        { "name": "Listar pedidos (paginado)", "request": { "method": "GET", "url": "{{baseUrl}}/pedidos?page=0&size=10" } },
        {
          "name": "Cambiar estado",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/pedidos/1/estado",
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"EN_PREPARACION\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Cupones",
      "item": [
        {
          "name": "Crear cupón",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/cupones",
            "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"BIENVENIDA10\",\n  \"tipo\": \"PORCENTAJE\",\n  \"valor\": 10.00,\n  \"fechaInicio\": \"2026-11-01T00:00:00\",\n  \"fechaFin\": \"2026-12-31T23:59:59\",\n  \"maxUsos\": 100,\n  \"importeMinimo\": 5.00,\n  \"clienteId\": null\n}" }
          }
        },
        {
          "name": "Validar cupón",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/cupones/validar",
            "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"BIENVENIDA10\",\n  \"subtotal\": 12.50\n}" }
          }
        }
      ]
    },
    {
      "name": "Informes",
      "item": [
        { "name": "Ventas del día", "request": { "method": "GET", "url": "{{baseUrl}}/informes/ventas-dia?fecha=2026-10-01" } },
        { "name": "Productos más vendidos", "request": { "method": "GET", "url": "{{baseUrl}}/informes/productos-top?desde=2026-10-01&hasta=2026-10-31&limite=5" } }
      ]
    }
  ]
}
