                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "4. PUT /productos/{id} - Modificación (ADMIN)",
          "description": "Modifica nombre, descripción, precio, categoría y alérgenos. RN-03: cambiar el precio no afecta a los pedidos ya hechos, porque cada línea guarda su precio unitario.",
          "item": [
            {
              "name": "Modificar producto",
              "request": {
                "method": "PUT",
                "url": "{{baseUrl}}/productos/{{productoCreadoId}}",
                "description": "Modifica el producto creado en el endpoint 3: sube el precio y le quita el huevo.",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Muffin de arándanos\",\n  \"descripcion\": \"Muffin casero, ahora más grande\",\n  \"precio\": 2.4,\n  \"categoriaId\": 3,\n  \"alergenosIds\": [\n    1,\n    7\n  ]\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                      "const p = pm.response.json();",
                      "pm.test('Precio actualizado', () => pm.expect(p.precio).to.eql(2.40));",
                      "pm.test('Alérgenos sustituidos', () => pm.expect(p.alergenos).to.have.lengthOf(2));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Error: producto inexistente (404)",
              "request": {
                "method": "PUT",
                "url": "{{baseUrl}}/productos/9999",
                "description": "Un id que no existe devuelve 404.",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"No existe\",\n  \"precio\": 1.0,\n  \"categoriaId\": 1\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 404', () => pm.response.to.have.status(404));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "RN-01: producto dado de baja (422)",
              "request": {
                "method": "PUT",
                "url": "{{baseUrl}}/productos/12",
                "description": "La Ensaimada está dada de baja y no se puede modificar.",
