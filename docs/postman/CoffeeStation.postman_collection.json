        {
          "name": "5. PATCH /productos/{id}/disponibilidad (ADMIN, BARISTA)",
          "description": "Marca un producto como agotado (false) o disponible (true).",
          "item": [
            {
              "name": "Marcar como agotado",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/productos/{{productoCreadoId}}/disponibilidad",
                "description": "El producto creado en el endpoint 3 se queda sin existencias.",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"disponible\": false\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                      "pm.test('Agotado', () => pm.expect(pm.response.json().disponible).to.be.false);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Reponer (disponible)",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/productos/{{productoCreadoId}}/disponibilidad",
                "description": "Vuelve a haber existencias.",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"disponible\": true\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                      "pm.test('Disponible', () => pm.expect(pm.response.json().disponible).to.be.true);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Error: falta 'disponible' (400)",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/productos/{{productoCreadoId}}/disponibilidad",
                "description": "El campo disponible es obligatorio.",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Devuelve 400', () => pm.response.to.have.status(400));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Error: producto inexistente (404)",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/productos/9999/disponibilidad",
                "description": "Un id que no existe devuelve 404.",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
