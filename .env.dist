# plantilla de variables de entorno locales.
#
# 1. copia este archivo como .env en la raíz del proyecto:
#      PowerShell:  Copy-Item .env.dist .env
#      Bash:        cp .env.dist .env
# 2. rellena los valores en .env (sin comillas y sin espacios alrededor del =).
# 3. no subas nunca .env a Git: está en el .gitignore. este archivo (.env.dist) sí se sube,
#    pero solo con valores de ejemplo, nunca con credenciales reales.
#
# Spring Boot lee .env al arrancar gracias a
# spring.config.import=optional:file:.env[.properties] en application.properties.

# --- base de datos PostgreSQL ---------------------------------
# URL JDBC: jdbc:postgresql://<host>:<puerto>/<base_de_datos>?currentSchema=<esquema>
DB_URL=jdbc:postgresql://localhost:5432/postgres?currentSchema=coffestation
DB_USER=postgres
DB_PASSWORD=
